{
  "manifest_version": 3,
  "name": "Claude Usage Tracker",
  "version": "1.1.0",
  "description": "Shows a live usage bar at the top of claude.ai — session %, weekly %, and countdown to reset.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Claude Usage Tracker — click to toggle bar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
